; Engine configuration file.
; DIY.CAD - parametric CAD built on Godot

config_version=5

[application]

config/name="DIY.CAD"
config/description="Parametric, feature-based CAD program written in Godot"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=true
config/icon="res://branding/icon_small.png"
boot_splash/bg_color=Color(0.973, 0.98, 0.996, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://branding/splash.png"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2

[gui]

common/snap_controls_to_pixels=true

[rendering]

anti_aliasing/quality/msaa_3d=2
